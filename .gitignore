# 产物：视频/音频/抽帧都很大，绝不入库
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.mp3
*.flac
frames/
*.jpg
*.jpeg
*.png

# 运行期产物
play.json
stream.json
detail.json
transcript.txt
summary.md
*.log
*.lock
index.json
index.md

# 测试固件是手写的假语料，不是真转写，必须入库（上面忽略了所有 transcript.txt）
!tests/fixtures/**/transcript.txt

# 示例产物同理：README 第一屏引用的就是它们，被上面按文件名忽略掉的话仓库里会缺文件
!docs/example/summary.md
!docs/example/transcript.txt

# 浏览器 profile / 登录态：可能含 cookie，永远不要提交
*.ocr-venv/

# Python
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.venv/
venv/
ocr-venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 测试临时目录（系统 TEMP 不可用时 tempfile 会退化到当前目录）
tmp*/
.tmp/

# Selenium 手动放的本机驱动（各人路径不同，不该进仓库）
msedgedriver/
chromedriver/
geckodriver/
